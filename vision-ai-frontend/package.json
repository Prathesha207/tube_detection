{
  "name": "vision-monitor",
  "desktopName": "vision-monitor",
  "version": "0.1.0",
  "description": "Vision Monitor Desktop Application",
  "homepage": "https://github.com/Prathesha207/vision-monitor",
  "author": {
    "name": "Vision-Monitor",
    "email": "dev@vision-monitor.com"
  },
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron --no-sandbox .\"",
    "electron-build": "npm run build && electron-builder",
    "package:win:x64": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:linux:x64": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "package:linux:arm64": "npm run build && electron-builder --linux AppImage deb --arm64 --publish never"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^12.38.0",
    "js-cookie": "^3.0.5",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.546.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.72.0",
    "react-icons": "^5.6.0",
    "react-virtuoso": "^4.18.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.1.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "wait-on": "^9.0.4",
    "zustand": "^5.0.15",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "motion": "^12.23.24",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/express": "^4.17.21",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.visionmonitor.application",
    "compression": "maximum",
    "asar": true,
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist_app"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../vision-ai-backend/dist/backend",
        "to": "backend"
      }
    ],
    "linux": {
      "syncDesktopName": true,
      "icon": "public/icon.png",
      "executableArgs": [
        "--no-sandbox"
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "deb": {
      "compression": "gz"
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vision Monitor",
      "runAfterFinish": true,
      "unicode": true
    }
  }
}
